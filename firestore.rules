rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserProfile(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validRole(role) {
      return role in ['Farmer', 'Buyer'];
    }

    // Account metadata only. Authentication passwords are never stored in Firestore.
    match /users/{uid} {
      allow read: if ownsUserProfile(uid);

      allow create: if ownsUserProfile(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'phoneNumber', 'role', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && validRole(request.resource.data.role);

      allow update: if ownsUserProfile(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'phoneNumber', 'role', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // Deny everything else until owner-scoped sync rules are added for each collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
